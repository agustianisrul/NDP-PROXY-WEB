        "@angular/platform-server": "^20.1.0",
        "@angular/router": "^20.1.0",
        "@angular/ssr": "^20.1.1",
        "@primeuix/themes": "^1.2.5",
        "bcryptjs": "^3.0.2",
        "body-parser": "^1.20.3",
        "chart.js": "^4.5.1",
        "cookie-parser": "^1.4.7",
        "cookie-session": "^2.1.1",
        "dotenv": "^17.2.3",
