        "tslib": "^2.3.0",
        "uuid": "^13.0.0",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular/build": "^20.1.1",
        "@angular/cli": "^20.1.1",
        "@angular/compiler-cli": "^20.1.0",
        "@types/body-parser": "^1.19.5",
        "@types/cookie-parser": "^1.4.9",
        "@types/cookie-session": "^2.0.49",
        "@types/express": "^5.0.1",
        "@types/jasmine": "~5.1.0",
