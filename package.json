{
    "name": "ndp-proxy-web",
    "version": "1.0.0-uat.1",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build:local": "ng build --configuration development",
        "build:production": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "serve:ssr": "node dist/NDP-PROXY-WEB/server/server.mjs",
        "start:local": "npm run build:local && cross-env NODE_ENV=production npm run serve:ssr",
        "start:production": "npm run build:production && cross-env NODE_ENV=production npm run serve:ssr"
    },
    "prettier": {
        "printWidth": 150,
        "singleQuote": true,
        "tabWidth": 4,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular",
                    "tabWidth": 4
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^20.1.0",
        "@angular/compiler": "^20.1.0",
        "@angular/core": "^20.1.0",
        "@angular/forms": "^20.1.0",
